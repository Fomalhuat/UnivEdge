{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnchorTable",
  "description": "锚点对照表：NC-01 检查器的输入格式（见 VERIFICATION.md §5）",
  "type": "object",
  "required": ["criteria"],
  "properties": {
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "description": "判据名（物理量，含单位）" },
          "value": { "type": "number", "description": "复现值" },
          "reference": { "type": "number", "description": "参考值（锚点）" },
          "tolerance": { "type": "number", "description": "相对误差阈值，缺省用 default_tol" },
          "note": { "type": "string", "description": "来源/备注（如文献公式编号）" }
        },
        "additionalProperties": true
      }
    }
  }
}
